# Placeholders only. Never commit real values. See docs/DEPLOYMENT.md.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Set true only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=
MAX_BODY_BYTES=262144
# Bearer token for /api/v1/metrics, min 16 chars. Unset disables the endpoint.
METRICS_TOKEN=

# The database must use UTF8 encoding. Add sslmode=require in production.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/language_manager?connection_limit=20&pool_timeout=10
# Required in production. Unset in development uses an in-process store.
REDIS_URL=

JWT_ISSUER=language-manager
JWT_AUDIENCE=language-manager-clients
JWT_ACCESS_TOKEN_TTL=900
JWT_KEY_ID=key-1
# Ed25519 PEM keys with newlines written as \n. See docs/DEPLOYMENT.md.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_RETIRED_PUBLIC_KEYS={}

REFRESH_TOKEN_TTL=2592000
REFRESH_REUSE_LEEWAY_SECONDS=10
MAX_SESSIONS_PER_USER=10

SUPPORTED_GENDERS=male,female,other,prefer_not_to_say
REQUIRE_VERIFIED_MOBILE=true
# console logs codes (development only); twilio sends real SMS.
VERIFICATION_PROVIDER=console
VERIFICATION_CODE_TTL=600
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# A provider is enabled when its credentials below are set.
# Either an API key (Translation API v2), or a project with credentials (v3).
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CONCURRENCY=20
GOOGLE_RATE_PER_MINUTE=600
GOOGLE_TIMEOUT_MS=10000

ANTHROPIC_API_KEY=
# claude-sonnet-5-5 is about twice as fast as Opus here. Haiku's Arabic pronunciation was unreliable.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=16000
CLAUDE_CONCURRENCY=5
CLAUDE_RATE_PER_MINUTE=60
CLAUDE_TIMEOUT_MS=60000

PROVIDER_QUEUE_LIMIT=100
PROVIDER_MAX_RETRIES=2
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_MS=30000

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_LINK_TTL=900
# Adds a pronunciation line per language, using one extra Claude call.
TELEGRAM_PRONUNCIATION=true

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_MAX=10

TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL=86400
TRANSLATION_MAX_INPUT_LENGTH=10000
TRANSLATION_ASYNC_MAX_INPUT_LENGTH=100000
TRANSLATION_ALLOW_FALLBACK=false
TRANSLATION_DAILY_CHAR_QUOTA=200000
MULTILINGUAL_TARGETS=dutch,english,arabicSaudiArabia
# partial returns successful targets; fail rejects the whole request.
MULTILINGUAL_PARTIAL_FAILURE=partial

HISTORY_ENABLED=true
HISTORY_RETENTION_DAYS=90

JOB_QUEUE_MAX_DEPTH=1000
JOB_WORKER_CONCURRENCY=5
JOB_MAX_ATTEMPTS=3
