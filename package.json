{
  "name": "language-manager-api",
  "version": "1.0.3",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "prisma generate && next build && npm run build:worker",
    "dev": "next dev",
    "build:worker": "esbuild scripts/worker.ts scripts/set-webhook.ts scripts/sync-languages.ts --bundle --platform=node --target=node24 --packages=external --tsconfig=tsconfig.json --outdir=dist --format=cjs && esbuild prisma/seed.ts --bundle --platform=node --target=node24 --packages=external --outdir=dist --format=cjs",
    "release:package": "node scripts/package-release.mjs",
    "start": "next start",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch scripts/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "languages:sync": "tsx --env-file=.env scripts/sync-languages.ts",
    "telegram:set-webhook": "tsx --env-file=.env scripts/set-webhook.ts",
    "db:local": "node scripts/dev-db.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google-cloud/translate": "^10.3.0",
    "@opennextjs/cloudflare": "^1.20.15",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.14",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.3",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true
  }
}
